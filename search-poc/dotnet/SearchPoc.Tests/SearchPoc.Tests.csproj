<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\SearchPoc.Core\SearchPoc.Core.csproj" />
    <ProjectReference Include="..\SearchPoc.Lambda\SearchPoc.Lambda.csproj" />
    <Content Include="..\..\shared\field-registry.json" Link="shared\field-registry.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\shared\parser-fixtures.json" Link="shared\parser-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
