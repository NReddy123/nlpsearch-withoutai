{
  "name": "search-poc",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test:typescript": "node --experimental-strip-types --test typescript/tests/*.test.ts",
    "typecheck:typescript": "tsc -p typescript/tsconfig.json",
    "build:angular": "ngc -p angular/tsconfig.app.json --noEmit && vite build --config angular/vite.config.ts",
    "start:angular": "vite --config angular/vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.1",
    "@angular/build": "20.3.40",
    "@angular/compiler-cli": "20.3.34",
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vite": "7.3.7"
  }
}
